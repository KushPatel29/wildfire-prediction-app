table fact_season_scores
	lineageTag: 141b8df0-00c4-50d4-9362-cd3dcbed0ceb

	column year
		dataType: int64
		formatString: 0
		lineageTag: cace3003-c2bc-5946-8f33-551ef972977b
		summarizeBy: sum
		sourceColumn: year

	column method
		dataType: string
		lineageTag: 3ffa1fd7-e079-54cf-bb97-58eff81ad713
		summarizeBy: none
		sourceColumn: method

	column method_label
		dataType: string
		lineageTag: 78e005e6-d909-52c1-be53-6864a74da5aa
		summarizeBy: none
		sourceColumn: method_label

	column is_model
		dataType: int64
		formatString: 0
		lineageTag: de15be15-b83a-51d6-b564-d5ea9c7e875d
		summarizeBy: sum
		sourceColumn: is_model

	column same_day_top_decile
		dataType: double
		formatString: #,0.00
