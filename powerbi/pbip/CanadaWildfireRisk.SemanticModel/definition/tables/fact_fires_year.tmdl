	partition fact_fires_year = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataPath & "\data\fact_fires_year.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"year", Int64.Type}, {"province", type text}, {"cause_label", type text}, {"fires", Int64.Type}, {"area_ha", type number}, {"large_fires", Int64.Type}, {"province_short", type text}})
				in
				    Typed
