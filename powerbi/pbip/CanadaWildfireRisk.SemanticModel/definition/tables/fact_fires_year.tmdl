table fact_fires_year
	lineageTag: fc18c38a-b808-5fec-a1ee-9877e5c83dfd

	column year
		dataType: int64
		formatString: 0
		lineageTag: 0fca1752-7aa4-51ef-b266-651a28a55b94
		summarizeBy: sum
		sourceColumn: year

	column province
		dataType: string
		lineageTag: 426dc61e-101b-5188-8034-3343cb9db73d
		summarizeBy: none
		sourceColumn: province

	column cause_label
		dataType: string
		lineageTag: 5363435e-bc3f-5439-834d-6b46cce14f5b
		summarizeBy: none
		sourceColumn: cause_label

	column fires
		dataType: int64
		formatString: 0
		lineageTag: 197acad2-c4b9-58cf-b493-b81861e70e9e
		summarizeBy: sum
		sourceColumn: fires

	column area_ha
		dataType: double
		formatString: #,0
		lineageTag: b1717575-a7ad-57a8-8854-c508bd3f6d13
		summarizeBy: sum
