	measure 'R squared out of time' = CALCULATE([R squared], fact_hackathon_scores[scoring] = "out_of_time", fact_hackathon_scores[panel] = "nfdb")
		formatString: 0.000
		lineageTag: e4edc3ea-ba7f-5492-93e9-6806adb594a9
