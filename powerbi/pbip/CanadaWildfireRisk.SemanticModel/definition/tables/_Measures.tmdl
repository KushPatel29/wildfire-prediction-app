	measure 'KPI SVG Season capture | Season reference @304' =
			VAR vValue = [Season capture]
			VAR vShown = IF(ISBLANK(vValue), "—", FORMAT(vValue, "0.0%"))
			VAR vCaptionRaw = SUBSTITUTE(SUBSTITUTE(COALESCE([Season reference], ""), "&", "&amp;"), "<", "&lt;")
			VAR vCaption = IF(LEN(vCaptionRaw) > 59, LEFT(vCaptionRaw, 57) & "…", vCaptionRaw)
			VAR vRail = ROUND(272 * MAX(0, MIN(1, COALESCE(vValue, 0))), 0)
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='304' height='112' viewBox='0 0 304 112'>"
			        & "<rect x='0' y='18' width='3' height='76' rx='1.5' fill='#3987e5'/>"
			        & "<text x='16' y='28' font-family='Segoe UI' font-size='11' fill='#a6a6ad'>Season capture</text>"
			        & "<text x='16' y='64' font-family='Segoe UI Light' font-size='30' fill='#f2f2f4'>" & vShown & "</text>"
			        & "<rect x='16' y='76' width='272' height='6' rx='3' fill='#26262a'/>" & "<rect x='16' y='76' width='" & vRail & "' height='6' rx='3' fill='#3987e5'/>"
			        & "<text x='16' y='100' font-family='Segoe UI' font-size='10' fill='#7d7d85'>" & vCaption & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
