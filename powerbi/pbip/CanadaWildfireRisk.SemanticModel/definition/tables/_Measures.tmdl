table _Measures
	lineageTag: b3af0e1a-e074-5138-8219-b2afbf523da6

	measure 'Cells forecast' = DISTINCTCOUNT(fact_forecast[cell_id])
		formatString: #,0
		lineageTag: 9fbc9d9a-4bb7-54e3-a16f-51aef320242b
		displayFolder: 01 Forecast

	measure 'Mean risk' = AVERAGE(fact_forecast[risk])
		formatString: 0.0%
		lineageTag: 5216fafe-4122-5144-a940-2ff92937bce5
		displayFolder: 01 Forecast

	measure 'Peak risk' = MAX(fact_forecast[risk])
		formatString: 0.0%
		lineageTag: b77abcb1-d48c-57c0-8e9c-dfff2a9e434c
		displayFolder: 01 Forecast

	measure 'Peak large-fire risk' = MAX(fact_forecast[large_risk])
		formatString: 0.00%
		lineageTag: 9b114d33-1b4f-5464-a3da-afde7868b7f5
		displayFolder: 01 Forecast

	measure 'Cells in the riskiest tenth' = CALCULATE(DISTINCTCOUNT(fact_forecast[cell_id]), fact_forecast[in_top_decile] = 1)
		formatString: #,0
		lineageTag: 39a8b9d7-ed09-54c1-a8fb-723a3411d471
		displayFolder: 01 Forecast

	measure 'Risk against normal' = DIVIDE(AVERAGE(fact_forecast[risk]), AVERAGE(fact_forecast[clim_month_rate]))
		formatString: 0.00
		lineageTag: f45df131-6dfd-5e27-b938-c58d55694d30
		displayFolder: 01 Forecast

	measure 'Mean FWI' = AVERAGE(fact_forecast[fwi])
		formatString: 0.0
		lineageTag: 1b53ee98-7744-5cf7-a567-8519c13b86d9
		displayFolder: 01 Forecast

	measure 'Hotspots in the last two days' = COUNTROWS(fact_hotspot)
		formatString: #,0
		lineageTag: d7002e3a-68ef-5db7-be08-aabf14187343
		displayFolder: 01 Forecast

	measure 'Stations behind the forecast' = MAX(fact_forecast_run[stations_used])
		formatString: #,0
		lineageTag: 0611c20c-0078-5ccf-8f87-5f52212753d0
		displayFolder: 01 Forecast

	measure 'Forecast built' = MAX(fact_forecast_run[generated_at])
		lineageTag: f5c510b4-0745-58d8-9f2c-dd1360703cc4
		displayFolder: 01 Forecast

	measure 'Starts from' = FORMAT(MAX(fact_forecast_run[as_of]), "yyyy-mm-dd")
		lineageTag: 769c1541-9493-5704-a393-a445b2f4298f
		displayFolder: 01 Forecast

	measure 'Fires recorded' = SUM(fact_fires_year[fires])
		formatString: #,0
		lineageTag: a172c3ec-26af-54f1-9d29-d5aa69217abb
		displayFolder: 02 Fire record

	measure 'Area burned' = SUM(fact_fires_year[area_ha])
		formatString: #,0
		lineageTag: 89810919-8414-5851-97b1-cd92236a5ea9
		displayFolder: 02 Fire record

	measure 'Area burned (million ha)' = DIVIDE(SUM(fact_fires_year[area_ha]), 1000000)
		formatString: 0.0
		lineageTag: f3283c03-cc8c-5f70-8d5e-d480f2a65c19
		displayFolder: 02 Fire record

	measure 'Large fires recorded' = SUM(fact_fires_year[large_fires])
		formatString: #,0
		lineageTag: 1365662f-2414-534d-9640-28d99d1e43d2
		displayFolder: 02 Fire record

	measure 'Lightning share of fires' = DIVIDE(CALCULATE([Fires recorded], fact_fires_year[cause_label] = "Lightning"), [Fires recorded])
		formatString: 0.0%
		lineageTag: 54c4b707-24be-54e8-b682-a6c94b77f94c
		displayFolder: 02 Fire record

	measure 'Lightning share of area' = DIVIDE(CALCULATE([Area burned], fact_fires_year[cause_label] = "Lightning"), [Area burned])
		formatString: 0.0%
		lineageTag: 02c405a0-aad5-583e-a1e9-1868bd8c0394
		displayFolder: 02 Fire record

	measure 'Fires in the month' = SUM(fact_fires_month[fires])
		formatString: #,0
		lineageTag: ace4f6e6-2278-5f4d-9bdc-98698831c429
		displayFolder: 02 Fire record

	measure 'Share of the season' = DIVIDE([Fires in the month], CALCULATE([Fires in the month], ALL(fact_fires_month[month], fact_fires_month[month_name])))
		formatString: 0.0%
		lineageTag: 4ff1d7af-65b3-5323-8a27-a5b285b3a1df
		displayFolder: 02 Fire record

	measure 'Fires in the test seasons' = SUM(fact_backtest_day[fires])
