	measure 'Hectares the 2024 model forecast' = SUM(fact_hackathon_month[predicted_ha_without_count])
		formatString: #,0
		lineageTag: 2103ca2e-9f12-5566-920f-4562d80bd724
		displayFolder: 06 The 2024 model

	measure 'How wrong the 2024 model was' = DIVIDE([Hectares the 2024 model forecast] - [Hectares burned], [Hectares burned])
		formatString: 0.0%
		lineageTag: 58751584-03fd-5a42-bed6-6f5a5e09fdac
		displayFolder: 06 The 2024 model

	measure 'R squared, the longer panel' = CALCULATE([R squared], fact_hackathon_scores[panel] = "nfdb")
		formatString: 0.000
		lineageTag: 97709180-1016-5a3f-8cec-2fba22894b6c
		displayFolder: 06 The 2024 model

	measure 'Mean error, the longer panel' = CALCULATE([Mean error, hectares], fact_hackathon_scores[panel] = "nfdb")
		formatString: #,0
		lineageTag: 26e7c3d4-6efb-522a-8db2-1d06819e013c
