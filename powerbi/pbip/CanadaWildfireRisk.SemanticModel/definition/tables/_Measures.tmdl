	measure 'R squared as scored in 2024' = CALCULATE([R squared], fact_hackathon_scores[scoring] = "as_scored_in_2024", fact_hackathon_scores[panel] = "nfdb")
		formatString: 0.000
		lineageTag: 486367b8-03eb-52d6-861e-e69fbf6c4a7e
