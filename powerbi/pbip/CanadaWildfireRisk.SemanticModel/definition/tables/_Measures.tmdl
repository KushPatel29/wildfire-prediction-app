	measure 'Fires in the riskiest tenth' = SUM(fact_backtest_day[fires_in_top_decile])
		formatString: #,0
		lineageTag: 405a8adf-0f13-54b0-b9cf-6056ff715966
		displayFolder: 03 Backtest

	measure 'Same-day capture' = DIVIDE([Fires in the riskiest tenth], [Fires in the test seasons])
		formatString: 0.0%
		lineageTag: dcb170ef-525f-5dc9-a980-c3a6f7adb1b2
		displayFolder: 03 Backtest

	measure 'Large fires in the test seasons' = SUM(fact_backtest_day[large_fires])
