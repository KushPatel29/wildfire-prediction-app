	measure 'What the random split was worth' = [R squared as scored in 2024] - [R squared out of time]
		formatString: 0.000
		lineageTag: 79fcb284-11db-5b4c-b8a2-909449046705
		displayFolder: 06 The 2024 model

	measure 'Forecast reference' = "Built " & [Forecast built] & "  ·  from station day " & [Starts from]
		lineageTag: 5de60a7f-c6e2-52bd-bafb-c4b8a68c793e
		displayFolder: 07 Reference

	measure 'Capture reference' = FORMAT([Fires in the riskiest tenth], "#,0") & " of " & FORMAT([Fires in the test seasons], "#,0") & " fires, " & FORMAT([Days scored], "#,0") & " days"
		lineageTag: 7059cbde-863d-52ac-ac17-0dbf0428701d
		displayFolder: 07 Reference

	measure 'Baseline reference' = "Climatology " & FORMAT([Climatology ROC-AUC out of time], "0.000") & "  ·  ahead by " & FORMAT([Ahead of climatology], "0.000")
		lineageTag: 0c3d6cfd-fc30-57dc-a105-8787719c8483
		displayFolder: 07 Reference

	measure 'Season reference' = FORMAT([New detections], "#,0") & " new detections over " & FORMAT([Season cell-days], "#,0") & " cell-days"
		lineageTag: f4294be6-621b-5394-9bf2-fd3875df7073
		displayFolder: 07 Reference

	measure 'Fire record reference' = FORMAT([Lightning share of fires], "0%") & " of starts are lightning, " & FORMAT([Lightning share of area], "0%") & " of the area"
		lineageTag: c9b2ffb4-0e30-5bfb-8610-e8687d13d3f8
		displayFolder: 07 Reference

	measure 'Riskiest tenth reference' = FORMAT([Cells in the riskiest tenth], "#,0") & " of " & FORMAT([Cells forecast], "#,0") & " cells, " & FORMAT([Risk against normal], "0.0") & "x normal"
		lineageTag: f4d0edad-673e-5b17-a033-df86f16ba280
		displayFolder: 07 Reference

	measure 'The 2024 model reference' = "Random split " & FORMAT([R squared as scored in 2024], "0.000") & "  ·  out of time " & FORMAT([R squared out of time], "0.000")
		lineageTag: f6a3b172-d642-5e1b-86f5-fdf03b06ceff
		displayFolder: 07 Reference

	measure 'Forecast verdict' =
			VAR vCells = [Cells in the riskiest tenth]
			VAR vPeak = [Peak risk]
			VAR vNormal = [Risk against normal]
			VAR vTop =
			    MAXX(TOPN(1, VALUES(fact_forecast[cell_id]), [Peak risk], DESC, fact_forecast[cell_id], ASC), CALCULATE(SELECTEDVALUE(fact_forecast[province])))
			RETURN
			    "The riskiest " & FORMAT(vCells, "#,0") & " cells hold the day's highest chance of a new fire," & " peaking at " & FORMAT(vPeak, "0.0%") & IF(ISBLANK(vTop), "", " in " & vTop) & ". Across the grid the forecast runs at " & FORMAT(vNormal, "0.0") & "x the normal rate for this month."
		lineageTag: 578ec2bc-fa74-5129-a7ab-9515da5c7d06
		displayFolder: 08 Verdict

